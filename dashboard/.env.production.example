# Production environment -- points at the PRODUCTION Supabase project and
# the PRODUCTION backend deployment. Pair with
# backend/.env.production.example: both must point at the same Supabase
# project. Set these as the dashboard service's environment variables in
# Railway/Render (see DEPLOYMENT.md) -- never commit real values to a
# file like this one.

# Project Settings -> API, in the PRODUCTION Supabase project. The anon/
# public key is safe to expose to the browser (it's what Row Level
# Security and Supabase Auth are for) -- never put the service role key
# here, that belongs only in the backend's environment.
NEXT_PUBLIC_SUPABASE_URL=https://your-production-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key

# The production backend service's deployed URL.
NEXT_PUBLIC_BACKEND_URL=https://guardrunagent-backend-production.onrender.com
