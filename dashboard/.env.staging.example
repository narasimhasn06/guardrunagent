# Staging environment -- points at the STAGING Supabase project and the
# STAGING backend deployment. Pair with backend/.env.staging.example:
# both must point at the same Supabase project. Set these as the
# dashboard service's environment variables in Railway/Render (see
# DEPLOYMENT.md) -- never commit real values to a file like this one.

# Project Settings -> API, in the STAGING Supabase project. The anon/
# public key is safe to expose to the browser (it's what Row Level
# Security and Supabase Auth are for) -- never put the service role key
# here, that belongs only in the backend's environment.
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key

# The staging backend service's deployed URL.
NEXT_PUBLIC_BACKEND_URL=https://guardrunagent-backend-staging.onrender.com
