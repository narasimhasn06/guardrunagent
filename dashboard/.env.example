# Project Settings -> API in the Supabase dashboard.
# The anon/public key is safe to expose to the browser (it's what Row
# Level Security and Supabase Auth are for) -- never put the service role
# key here, that belongs only in the backend's environment.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the FastAPI backend (docs/03-low-level-design.md Section 4).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
