# Staging environment -- points at the STAGING Supabase project, kept
# separate from production per docs/05-architecture-document.md Section 5
# ("a staging and a production Supabase project, kept separate to avoid
# pilot data mixing with test data"). Set these as the backend service's
# environment variables in Railway/Render (see DEPLOYMENT.md) -- never
# commit real values to a file like this one.

# Project Settings -> API, in the STAGING Supabase project
SUPABASE_URL=https://your-staging-project-ref.supabase.co

# Project Settings -> API -> service_role key (STAGING project)
# Server-only. Bypasses RLS. NEVER expose this to the dashboard/browser.
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# Project Settings -> API -> JWT Settings -> JWT Secret (STAGING project)
SUPABASE_JWT_SECRET=your-staging-jwt-secret

# A random secret, generated once for staging and never reused for
# production (e.g. `openssl rand -hex 32`). Keys the HMAC-SHA256 hash used
# to store/look up SDK API keys (see app/api_keys.py).
API_KEY_PEPPER=your-staging-random-pepper

# The staging dashboard service's deployed URL -- used to build the
# "Session [link]" in guardrail Slack alerts. Fill this in once the
# dashboard service exists (see DEPLOYMENT.md's "wire the two services
# together" step); leave unset until then, alerts just omit the link.
DASHBOARD_URL=https://guardrunagent-dashboard-staging.onrender.com
