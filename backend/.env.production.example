# Production environment -- points at the PRODUCTION Supabase project,
# kept separate from staging per docs/05-architecture-document.md
# Section 5 ("a staging and a production Supabase project, kept separate
# to avoid pilot data mixing with test data"). Set these as the backend
# service's environment variables in Railway/Render (see DEPLOYMENT.md)
# -- never commit real values to a file like this one.

# Project Settings -> API, in the PRODUCTION Supabase project
SUPABASE_URL=https://your-production-project-ref.supabase.co

# Project Settings -> API -> service_role key (PRODUCTION project)
# Server-only. Bypasses RLS. NEVER expose this to the dashboard/browser.
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# Project Settings -> API -> JWT Settings -> JWT Secret (PRODUCTION project)
SUPABASE_JWT_SECRET=your-production-jwt-secret

# The production dashboard service's deployed URL (a custom domain like
# https://app.guardrunagent.com once one exists, or the Railway/Render
# service URL until then) -- used to build the "Session [link]" in
# guardrail Slack alerts.
DASHBOARD_URL=https://guardrunagent-dashboard-production.onrender.com
