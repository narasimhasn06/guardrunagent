# Project Settings -> API in the Supabase dashboard
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API -> service_role key
# Server-only. Bypasses RLS. NEVER expose this to the Next.js frontend/browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Legacy JWT Settings -> JWT Secret (Project Settings -> API).
# The primary way dashboard JWTs are verified is Supabase's public JWKS
# (no config needed here -- see app/auth.py); this is only a fallback for
# a project that hasn't migrated to JWT Signing Keys (asymmetric keys,
# e.g. ES256). Safe to leave unset on a project using JWKS-only, but
# don't remove it from a deployment that still relies on the fallback --
# doing so just makes any legacy-signed token fail closed with a 401
# instead of silently working.
SUPABASE_JWT_SECRET=your-jwt-secret

# A random secret, generated once for this environment (e.g. `openssl rand
# -hex 32`) and never reused across environments. Keys the HMAC-SHA256 hash
# used to store/look up SDK API keys (see app/api_keys.py) -- rotating this
# invalidates every issued API key at once, same as rotating the JWT secret.
API_KEY_PEPPER=your-random-pepper

# Optional. Base URL of the deployed Next.js dashboard, e.g. https://app.guardrunagent.com
# Used to build the "Session [link]" in guardrail Slack alerts. Leave unset
# until the dashboard has a real URL -- alerts just omit the link until then.
DASHBOARD_URL=
