# Project Settings -> API in the Supabase dashboard
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API -> service_role key
# Server-only. Bypasses RLS. NEVER expose this to the Next.js frontend/browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Project Settings -> API -> JWT Settings -> JWT Secret
# Used to verify Supabase JWTs sent by the dashboard on human-authenticated requests.
SUPABASE_JWT_SECRET=your-jwt-secret

# Optional. Base URL of the deployed Next.js dashboard, e.g. https://app.guardrunagent.com
# Used to build the "Session [link]" in guardrail Slack alerts. Leave unset
# until the dashboard has a real URL -- alerts just omit the link until then.
DASHBOARD_URL=
